{
  "permissions": {
    "allow": [
      "Bash(npm install:*)",
      "Bash(npm run *:*)",
      "Bash(npx vitest:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx vite:*)",
      "Bash(npx vite build:*)",
      "Bash(npx tsc:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
